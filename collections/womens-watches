<style>
        :root {
            --primary-color: #ffffff;
            --secondary-color: #000000;
            --bg-dark: #0a0a0a;
            --bg-light: #1a1a1a;
            --text-light: #cccccc;
            --accent: #ffffff;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--primary-color);
        }

        .header {
            margin-top: 0;
        }

        .all-products-hero {
            background: linear-gradient(135deg, var(--bg-light) 0%, var(--secondary-color) 100%);
            padding: 80px 40px;
            text-align: center;
            border-bottom: 3px solid var(--accent);
            margin-top: 100px;
        }

        .all-products-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--primary-color);
        }

        .all-products-hero p {
            font-size: 1.2rem;
            color: var(--text-light);
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.8;
        }

        .products-container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 60px 40px;
        }

        .products-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 50px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .products-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            margin: 0;
            color: var(--primary-color);
        }

        .filter-controls {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background-color: var(--bg-light);
            color: var(--text-light);
            border: 2px solid transparent;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .filter-btn.active,
        .filter-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }


        .product-card {
            background: var(--bg-light);
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            border-color: var(--accent);
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(212, 175, 55, 0.2);
        }

        .product-image {
            width: 100%;
            height: 280px;
            object-fit: cover;
            display: block;
        }

        .product-info {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .product-info h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            margin: 0 0 10px 0;
            color: var(--primary-color);
        }

        .product-info p {
            color: var(--text-light);
            font-size: 0.9rem;
            margin: 0 0 15px 0;
            line-height: 1.6;
            flex-grow: 1;
        }

        .product-price {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .product-actions {
            display: flex;
            gap: 10px;
        }

        .add-to-cart,
        .view-details {
            flex: 1;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-decoration: none;
            text-align: center;
            display: inline-block;
        }

        .add-to-cart {
            background-color: var(--accent);
            color: var(--secondary-color);
        }

        .add-to-cart:hover {
            background-color: #e0c061;
            transform: translateY(-2px);
        }

        .view-details {
            background-color: transparent;
            color: var(--accent);
            border: 2px solid var(--accent);
        }

        .view-details:hover {
            background-color: var(--accent);
            color: var(--secondary-color);
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 40px;
        }

        .pagination button,
        .pagination a {
            padding: 10px 15px;
            background-color: var(--bg-light);
            color: var(--text-light);
            border: 2px solid transparent;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            font-weight: 500;
        }

        .pagination button:hover,
        .pagination a:hover,
        .pagination .active {
            border-color: var(--accent);
            color: var(--accent);
        }

        @media (max-width: 1024px) {
            .products-container {
                padding: 40px 30px;
            }

            .all-products-hero {
                padding: 60px 30px;
            }

            .all-products-hero h1 {
                font-size: 2.2rem;
            }

        }

        @media (max-width: 768px) {
            .products-container {
                padding: 30px 20px;
            }

            .all-products-hero {
                padding: 40px 20px;
                margin-top: 80px;
            }

            .all-products-hero h1 {
                font-size: 1.8rem;
            }

            .all-products-hero p {
                font-size: 1rem;
            }

            .products-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .filter-controls {
                width: 100%;
                justify-content: space-between;
            }


            .product-card {
                border-radius: 6px;
            }

            .product-image {
                height: 200px;
            }

            .product-info {
                padding: 15px;
            }

            .product-info h3 {
                font-size: 1rem;
            }

            .product-info p {
                font-size: 0.8rem;
            }

            .product-price {
                font-size: 1.1rem;
            }

            .product-actions {
                flex-direction: column;
            }

            .add-to-cart,
            .view-details {
                width: 100%;
            }
        }
    </style>
</head>
