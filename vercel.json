{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/all-products", "destination": "/all-products.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/for-her", "destination": "/for-her.html" },
    { "source": "/for-him", "destination": "/for-him.html" },
    { "source": "/product", "destination": "/product.html" }
  ],
  "headers": [
    {
      "source": "/checkout(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
